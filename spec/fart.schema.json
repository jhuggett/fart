{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/jhuggett/fart/main/spec/fart.schema.json",
  "title": "Fast Art Format (.fart), version 1.5",
  "description": "JSON-backed vector art for games: shapes, recolorable palette tokens, re-posable parts, states; since 1.3 also 3D documents (space: \"3d\") with mesh, ball and rod shapes, and shade on shapes. This schema checks structure; spec/FORMAT.md holds meaning, and the validator in packages/core adds the cross-reference checks a schema cannot express (names resolve, tris index the points). Unknown fields are allowed everywhere: editors preserve them, loaders ignore them.",
  "type": "object",
  "required": [
    "version"
  ],
  "properties": {
    "version": {
      "const": 1,
      "description": "The format major. Readers must reject anything newer than they know."
    },
    "name": {
      "type": "string"
    },
    "palette_refs": {
      "type": "array",
      "description": "Other .fart files whose palettes this one borrows, relative to this file, resolved in order. Later refs beat earlier ones; the local palette beats them all.",
      "items": {
        "$ref": "#/$defs/relpath"
      }
    },
    "palette": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/token"
      }
    },
    "meta": {
      "$ref": "#/$defs/meta"
    },
    "space": {
      "enum": [
        "2d",
        "3d"
      ],
      "description": "Since 1.3: the document's space. Absent means 2d. A 3D document's points have three coordinates, its shapes are mesh, ball and rod, its turns are [x, y, z]; see FORMAT.md, Space: 3D."
    },
    "textures": {
      "type": "array",
      "description": "Since 1.5: textures, each a set of maps that are drawings tiled over a cell. See FORMAT.md, Textures.",
      "items": {
        "$ref": "#/$defs/texture"
      }
    }
  },
  "$defs": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "vec2": {
      "type": "array",
      "description": "[x, y]; y-down, x-right, in the project's world units.",
      "items": {
        "type": "number"
      },
      "minItems": 2,
      "maxItems": 2
    },
    "rgba": {
      "type": "array",
      "description": "[r, g, b, a], each 0-255. The field is named rgb and holds four components; the name is retained for compatibility.",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
      },
      "minItems": 4,
      "maxItems": 4
    },
    "relpath": {
      "type": "string",
      "description": "A relative path with forward slashes. Never absolute, never a drive letter.",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)[^/\\\\]"
    },
    "meta": {
      "type": "object",
      "description": "Yours. The format never looks inside."
    },
    "token": {
      "type": "object",
      "required": [
        "name",
        "rgb"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/name"
        },
        "rgb": {
          "$ref": "#/$defs/rgba"
        },
        "emissive": {
          "type": "number",
          "minimum": 0,
          "description": "Since 1.2: light the slot gives off; 0 or absent for none."
        }
      }
    },
    "shape": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "circle",
            "line",
            "poly"
          ]
        },
        "color": {
          "$ref": "#/$defs/name",
          "description": "A palette token, never a literal color."
        },
        "shade": {
          "type": "number",
          "minimum": 0,
          "description": "Since 1.3: multiplies the resolved colour's r, g, b; absent means 1."
        },
        "texture": {
          "$ref": "#/$defs/name",
          "description": "Since 1.5: a texture of the document, tiled over the shape."
        },
        "mapping": {
          "$ref": "#/$defs/mapping2"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "circle"
              }
            }
          },
          "then": {
            "required": [
              "at",
              "r"
            ],
            "properties": {
              "at": {
                "$ref": "#/$defs/vec2"
              },
              "r": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "line"
              }
            }
          },
          "then": {
            "required": [
              "a",
              "b",
              "w"
            ],
            "properties": {
              "a": {
                "$ref": "#/$defs/vec2"
              },
              "b": {
                "$ref": "#/$defs/vec2"
              },
              "w": {
                "type": "number",
                "minimum": 0,
                "description": "Stroke width. Round caps. In a collision list, the capsule's girth."
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "poly"
              }
            }
          },
          "then": {
            "required": [
              "points"
            ],
            "properties": {
              "points": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/vec2"
                },
                "minItems": 3
              },
              "tris": {
                "type": "array",
                "description": "Index triples into points, baked by editors on save. The validator checks the count is a multiple of three and every index is in range.",
                "items": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      ]
    },
    "drawn_shape": {
      "description": "A shape inside a part: it is painted, so it names a token.",
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/shape"
        },
        {
          "type": "object",
          "required": [
            "color"
          ],
          "properties": {
            "color": {
              "$ref": "#/$defs/name"
            }
          }
        }
      ]
    },
    "anchor": {
      "type": "object",
      "description": "A named document-space point a runtime may ask for: a grip, a muzzle, a hinge.",
      "required": [
        "name",
        "at"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/name"
        },
        "at": {
          "$ref": "#/$defs/vec2"
        },
        "angle": {
          "type": "number",
          "description": "Since 1.2: the direction an attached thing points, radians in the part's rest space."
        }
      }
    },
    "part": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/name"
        },
        "pivot": {
          "$ref": "#/$defs/vec2",
          "description": "Document-space point the runtime rotates about and places. Absent means [0, 0]."
        },
        "shapes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/drawn_shape"
          }
        },
        "anchors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/anchor"
          }
        },
        "meta": {
          "$ref": "#/$defs/meta"
        },
        "parent": {
          "$ref": "#/$defs/name",
          "description": "Since 1.1: the part this one is posed relative to. Must exist; no loops."
        },
        "like": {
          "$ref": "#/$defs/name",
          "description": "Since 1.2: this part draws that part's shapes and anchors and has none of its own."
        }
      }
    },
    "state_part": {
      "type": "object",
      "required": [
        "part"
      ],
      "properties": {
        "part": {
          "$ref": "#/$defs/name"
        },
        "offset": {
          "$ref": "#/$defs/vec2",
          "description": "Where the part's pivot lands. Absent means the pivot itself: the rest placement. Note this is a position, not a delta."
        },
        "rotate": {
          "type": "number",
          "description": "Radians about the pivot. Absent means 0."
        },
        "scale": {
          "type": "number",
          "minimum": 0,
          "description": "Multiplier about the pivot. Absent or 0 means 1."
        },
        "mirror": {
          "type": "boolean",
          "description": "Since 1.2: flipped left-to-right about the pivot, before the turn."
        }
      }
    },
    "state": {
      "type": "object",
      "description": "A named part list. Its order is paint order; parts it leaves out are not drawn.",
      "required": [
        "name",
        "parts"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/name"
        },
        "parts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/state_part"
          }
        },
        "targets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/target"
          }
        }
      }
    },
    "key": {
      "type": "object",
      "description": "One moment in a clip: a time and a pose, named or inline.",
      "required": [
        "t"
      ],
      "properties": {
        "t": {
          "type": "number",
          "minimum": 0,
          "description": "Seconds."
        },
        "state": {
          "$ref": "#/$defs/name"
        },
        "parts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/state_part"
          }
        },
        "ease": {
          "enum": [
            "linear",
            "in",
            "out",
            "in-out",
            "step"
          ],
          "description": "How time approaches this key from the previous one. Absent means linear."
        },
        "curve": {
          "type": "array",
          "description": "Since 1.2: a cubic bezier's control points [x1, y1, x2, y2], x within 0..1; wins over ease.",
          "items": {
            "type": "number"
          },
          "minItems": 4,
          "maxItems": 4,
          "prefixItems": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "number"
            },
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "number"
            }
          ]
        },
        "targets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/target"
          }
        },
        "events": {
          "type": "array",
          "description": "Since 1.2: names a runtime hears when the playhead crosses this key.",
          "items": {
            "$ref": "#/$defs/name"
          }
        }
      },
      "oneOf": [
        {
          "required": [
            "state"
          ],
          "properties": {
            "state": {
              "$ref": "#/$defs/name"
            }
          }
        },
        {
          "required": [
            "parts"
          ],
          "properties": {
            "parts": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/state_part"
              }
            }
          }
        }
      ]
    },
    "clip": {
      "type": "object",
      "required": [
        "name",
        "keys"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/name"
        },
        "loop": {
          "type": "boolean",
          "description": "Time wraps at the last key. Absent means false."
        },
        "keys": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/key"
          },
          "minItems": 1,
          "description": "In non-decreasing t; the validator checks the order."
        }
      }
    },
    "constraint": {
      "type": "object",
      "required": [
        "name",
        "chain",
        "end"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/name"
        },
        "chain": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/name"
          },
          "minItems": 1,
          "description": "Parts root-first, each parented to the previous."
        },
        "end": {
          "type": "string",
          "pattern": "^[^/]+/[^/]+$",
          "description": "part/anchor on the chain's last part."
        },
        "bend": {
          "enum": [
            1,
            -1
          ],
          "description": "Preferred elbow direction where a solution is ambiguous."
        }
      }
    },
    "target": {
      "type": "object",
      "description": "Since 1.2: where a chain should reach, document space.",
      "required": [
        "chain",
        "at"
      ],
      "properties": {
        "chain": {
          "$ref": "#/$defs/name"
        },
        "at": {
          "$ref": "#/$defs/vec2"
        }
      }
    },
    "vec3": {
      "type": "array",
      "description": "[x, y, z]; y-down, x-right, z-away, right-handed.",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3
    },
    "shape3": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "mesh",
            "ball",
            "rod"
          ]
        },
        "color": {
          "$ref": "#/$defs/name",
          "description": "A palette token, never a literal color."
        },
        "shade": {
          "type": "number",
          "minimum": 0
        },
        "texture": {
          "$ref": "#/$defs/name"
        },
        "mapping": {
          "$ref": "#/$defs/mapping3"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "ball"
              }
            }
          },
          "then": {
            "required": [
              "at",
              "r"
            ],
            "properties": {
              "at": {
                "$ref": "#/$defs/vec3"
              },
              "r": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "rod"
              }
            }
          },
          "then": {
            "required": [
              "a",
              "b",
              "w"
            ],
            "properties": {
              "a": {
                "$ref": "#/$defs/vec3"
              },
              "b": {
                "$ref": "#/$defs/vec3"
              },
              "w": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "mesh"
              }
            }
          },
          "then": {
            "required": [
              "points",
              "faces"
            ],
            "properties": {
              "points": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/vec3"
                },
                "minItems": 3
              },
              "faces": {
                "type": "array",
                "description": "Index loops into points, wound so (p1-p0)x(p2-p0) points outward. The validator checks each has three or more indices in range (error face).",
                "items": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              },
              "tris": {
                "type": "array",
                "description": "Index triples into points, baked by editors on save.",
                "items": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      ]
    },
    "drawn_shape3": {
      "description": "A 3D shape inside a part: painted, so it names a token.",
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/shape3"
        },
        {
          "type": "object",
          "required": [
            "color"
          ],
          "properties": {
            "color": {
              "$ref": "#/$defs/name"
            }
          }
        }
      ]
    },
    "anchor3": {
      "type": "object",
      "required": [
        "name",
        "at"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/name"
        },
        "at": {
          "$ref": "#/$defs/vec3"
        },
        "dir": {
          "$ref": "#/$defs/vec3",
          "description": "The direction an attached thing points, in the part's rest space."
        }
      }
    },
    "part3": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/name"
        },
        "pivot": {
          "$ref": "#/$defs/vec3"
        },
        "shapes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/drawn_shape3"
          }
        },
        "anchors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/anchor3"
          }
        },
        "meta": {
          "$ref": "#/$defs/meta"
        },
        "parent": {
          "$ref": "#/$defs/name"
        },
        "like": {
          "$ref": "#/$defs/name"
        }
      }
    },
    "state_part3": {
      "type": "object",
      "required": [
        "part"
      ],
      "properties": {
        "part": {
          "$ref": "#/$defs/name"
        },
        "offset": {
          "$ref": "#/$defs/vec3"
        },
        "rotate": {
          "$ref": "#/$defs/vec3",
          "description": "Radians about the pivot: about x, then y, then z. Absent means [0, 0, 0]."
        },
        "scale": {
          "type": "number",
          "minimum": 0
        },
        "mirror": {
          "type": "boolean"
        }
      }
    },
    "state3": {
      "type": "object",
      "required": [
        "name",
        "parts"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/name"
        },
        "parts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/state_part3"
          }
        },
        "targets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/target3"
          }
        }
      }
    },
    "key3": {
      "type": "object",
      "description": "One moment in a clip: a time and a pose, named or inline.",
      "required": [
        "t"
      ],
      "properties": {
        "t": {
          "type": "number",
          "minimum": 0,
          "description": "Seconds."
        },
        "state": {
          "$ref": "#/$defs/name"
        },
        "parts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/state_part3"
          }
        },
        "ease": {
          "enum": [
            "linear",
            "in",
            "out",
            "in-out",
            "step"
          ],
          "description": "How time approaches this key from the previous one. Absent means linear."
        },
        "curve": {
          "type": "array",
          "description": "Since 1.2: a cubic bezier's control points [x1, y1, x2, y2], x within 0..1; wins over ease.",
          "items": {
            "type": "number"
          },
          "minItems": 4,
          "maxItems": 4,
          "prefixItems": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "number"
            },
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "number"
            }
          ]
        },
        "targets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/target3"
          }
        },
        "events": {
          "type": "array",
          "description": "Since 1.2: names a runtime hears when the playhead crosses this key.",
          "items": {
            "$ref": "#/$defs/name"
          }
        }
      },
      "oneOf": [
        {
          "required": [
            "state"
          ],
          "properties": {
            "state": {
              "$ref": "#/$defs/name"
            }
          }
        },
        {
          "required": [
            "parts"
          ],
          "properties": {
            "parts": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/state_part3"
              }
            }
          }
        }
      ]
    },
    "clip3": {
      "type": "object",
      "required": [
        "name",
        "keys"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/name"
        },
        "loop": {
          "type": "boolean"
        },
        "keys": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/key3"
          },
          "minItems": 1
        }
      }
    },
    "constraint3": {
      "type": "object",
      "required": [
        "name",
        "chain",
        "end"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/name"
        },
        "chain": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/name"
          },
          "minItems": 1
        },
        "end": {
          "type": "string",
          "pattern": "^[^/]+/[^/]+$"
        },
        "pole": {
          "$ref": "#/$defs/vec3",
          "description": "A document-space point the first elbow leans toward."
        }
      }
    },
    "target3": {
      "type": "object",
      "required": [
        "chain",
        "at"
      ],
      "properties": {
        "chain": {
          "$ref": "#/$defs/name"
        },
        "at": {
          "$ref": "#/$defs/vec3"
        }
      }
    },
    "collision_shape": {
      "description": "A 2D collision shape: a document shape with, since 1.4, an optional part it rides and a layer an engine reads.",
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/shape"
        },
        {
          "type": "object",
          "properties": {
            "part": {
              "$ref": "#/$defs/name"
            },
            "layer": {
              "$ref": "#/$defs/name"
            },
            "meta": {
              "$ref": "#/$defs/meta"
            }
          }
        }
      ]
    },
    "collision_shape3": {
      "description": "A 3D collision shape: ball, rod, a convex mesh, or a box (collision only); optionally riding a part, with a layer.",
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "mesh",
            "ball",
            "rod",
            "box"
          ]
        },
        "color": {
          "$ref": "#/$defs/name"
        },
        "shade": {
          "type": "number",
          "minimum": 0
        },
        "part": {
          "$ref": "#/$defs/name"
        },
        "layer": {
          "$ref": "#/$defs/name"
        },
        "meta": {
          "$ref": "#/$defs/meta"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "ball"
              }
            }
          },
          "then": {
            "required": [
              "at",
              "r"
            ],
            "properties": {
              "at": {
                "$ref": "#/$defs/vec3"
              },
              "r": {
